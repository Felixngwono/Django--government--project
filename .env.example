# Copy this file to .env locally, then load it through your deployment environment.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=False
DB_NAME=django-government
DB_USER=root
DB_PASSWORD=replace-with-your-mysql-password
DB_HOST=localhost
DB_PORT=3306
OPENAI_API_KEY=your-openai-project-api-key
# Override only when you intentionally choose a different supported model.
OPENAI_MODEL=gpt-5.6
