# Copy this file to .env locally, then load it through your deployment environment.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=False
DB_NAME=django-government
DB_USER=rooti
DB_PASSWORD=replace-with-your-mysql-password
DB_HOST=localhost
DB_PORT=3306
OPENAI_API_KEY=your-openai-project-api-key
# Override only when you intentionally choose a different supported model.
OPENAI_MODEL=gpt-5.6

# Optional SMTP delivery for password-reset emails. The development default
# writes email to the runserver console; configure SMTP in deployment.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-smtp-username
# EMAIL_HOST_PASSWORD=your-smtp-password
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=GovTracker <noreply@example.com>

# Safaricom Daraja B2C. Keep real credentials in your deployment environment.
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_INITIATOR_NAME=
MPESA_SECURITY_CREDENTIAL=
MPESA_COMMAND_ID=BusinessPayment
MPESA_CALLBACK_BASE_URL=https://your-public-host.example
MPESA_CALLBACK_TOKEN=replace-with-a-random-secret-at-least-32-characters
MPESA_STK_SHORTCODE=
MPESA_STK_PASSKEY=
MPESA_STK_TRANSACTION_TYPE=CustomerPayBillOnline

# Africa's Talking SMS notifications for successful tender applicants.
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=
AFRICASTALKING_ENVIRONMENT=sandbox
# Optional; required by Africa's Talking before using a production Sender ID.
AFRICASTALKING_SENDER_ID=
